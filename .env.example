# Optional. When set, tour requests are emailed via Resend. Otherwise they are logged to the server console.
RESEND_API_KEY=
# Where tour requests go. Comma-separated is fine.
TOUR_REQUEST_TO=kyle@stringhamwebdesign.com
# Optional. Eventbrite organizer id (public). Leave blank to show the "events coming soon" state.
NEXT_PUBLIC_EVENTBRITE_ORGANIZER_ID=
# Optional. Public site URL for metadata.
NEXT_PUBLIC_SITE_URL=https://texasabacenters.com
