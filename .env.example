# Optional. When set, tour requests are emailed via Resend. Otherwise they are logged to the server console.
RESEND_API_KEY=
# Where tour requests go. Comma-separated is fine.
TOUR_REQUEST_TO=kyle@stringhamwebdesign.com
# Optional. Eventbrite organizer id (public). Leave blank to show the "events coming soon" state.
NEXT_PUBLIC_EVENTBRITE_ORGANIZER_ID=
# Optional. Public site URL for metadata.
NEXT_PUBLIC_SITE_URL=https://texasabacenters.com

# ── Caregiver Learning Center (/learn). All off by default. See docs/learning-center/INTEGRATION_BRIEF.md ──
# 1 = the /learn section exists and "Learn" appears in the header. Unset = every /learn route is a 404.
NEXT_PUBLIC_LEARN_ENABLED=
# 1 = show the labelled sample module and example training. Ignored on Vercel production.
LEARN_DEMO_CONTENT=
# 1 = fictional staff role switcher and seeded staff workflow. Local machine only: ignored whenever VERCEL is set.
LEARN_DEMO_STAFF=
